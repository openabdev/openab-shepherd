{
  "tools": [
    {
      "inputSchema": {
        "properties": {
          "choice": {
            "enum": [
              "allow_once",
              "deny_once"
            ],
            "type": "string"
          },
          "terminal": {
            "type": "string"
          }
        },
        "required": [
          "terminal",
          "choice"
        ],
        "type": "object"
      },
      "name": "answer_dialog"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "description": "Pane name, as start_pane or list_panes returned it.",
            "type": "string"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "draft_clear"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "type": "string"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "get_status"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "type": "string"
          },
          "timeout": {
            "maximum": 60.0,
            "minimum": 1.0,
            "type": "number"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "interrupt_pane"
    },
    {
      "inputSchema": {
        "properties": {
          "all": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "list_panes"
    },
    {
      "inputSchema": {
        "properties": {
          "lines": {
            "default": 0,
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "terminal": {
            "type": "string"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "read_output"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "description": "Pane name, as start_pane or list_panes returned it.",
            "type": "string"
          },
          "timeout": {
            "default": 2.0,
            "maximum": 60.0,
            "minimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "remove_pane"
    },
    {
      "inputSchema": {
        "properties": {
          "expires_secs": {
            "description": "Seconds until the routine expires; default and maximum come from the profile (default 7 days).",
            "maximum": 2592000,
            "minimum": 60,
            "type": "integer"
          },
          "max_runs": {
            "description": "Stop after this many sends.",
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "terminal": {
            "description": "Pane name, as start_pane or list_panes returned it.",
            "type": "string"
          },
          "text": {
            "description": "The line to type; at most 1024 bytes; not a bare yes, no, ok or number.",
            "type": "string"
          },
          "todo_file": {
            "description": "Relative path of a todo file in the pane's working directory; the line is typed only while it has an unchecked item.",
            "type": "string"
          },
          "trigger": {
            "description": "When to type. Only an every trigger exists.",
            "properties": {
              "every_secs": {
                "description": "Seconds between lines; the profile may set a higher minimum (default 600).",
                "maximum": 604800,
                "minimum": 60,
                "type": "integer"
              },
              "type": {
                "enum": [
                  "every"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "every_secs"
            ],
            "type": "object"
          }
        },
        "required": [
          "terminal",
          "trigger",
          "text"
        ],
        "type": "object"
      },
      "name": "routine_create"
    },
    {
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Routine id, as routine_create or routine_list showed it.",
            "type": "string"
          },
          "terminal": {
            "description": "Pane name.",
            "type": "string"
          }
        },
        "required": [
          "terminal",
          "id"
        ],
        "type": "object"
      },
      "name": "routine_delete"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "description": "Pane name. Omit to list every pane that has routines.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "routine_list"
    },
    {
      "inputSchema": {
        "properties": {
          "every_secs": {
            "maximum": 604800,
            "minimum": 60,
            "type": "integer"
          },
          "expires_secs": {
            "maximum": 2592000,
            "minimum": 60,
            "type": "integer"
          },
          "id": {
            "description": "Routine id, as routine_create or routine_list showed it.",
            "type": "string"
          },
          "max_runs": {
            "maximum": 10000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "terminal": {
            "description": "Pane name.",
            "type": "string"
          },
          "text": {
            "description": "At most 1024 bytes; not a bare yes, no, ok or number.",
            "type": "string"
          },
          "todo_file": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "terminal",
          "id"
        ],
        "type": "object"
      },
      "name": "routine_update"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "description": "Pane name, as start_pane or list_panes returned it.",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "terminal",
          "text"
        ],
        "type": "object"
      },
      "name": "send_input"
    },
    {
      "inputSchema": {
        "properties": {
          "agent": {
            "description": "With argv or line only (refused with profile, which fixes its agent): the agent the program is. Optional; without it the pane has no agent and answer_dialog refuses it.",
            "enum": [
              "kiro",
              "devin",
              "opencode"
            ],
            "type": "string"
          },
          "argv": {
            "description": "Program and arguments; non-empty. Only when arbitrary commands are allowed.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cwd": {
            "description": "Working directory (absolute).",
            "type": "string"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Extra environment variables for an argv or line pane only (refused with profile): at most 32, names [A-Z_][A-Z0-9_]*, values under the same input rules (empty allowed; leading and trailing whitespace is trimmed). A backend may refuse protected names (the native backend refuses HOME, PATH, USER, LANG, TERM and DYLD_*/LD_*); a backend without per-run environments returns unsupported.",
            "type": "object"
          },
          "extra_args": {
            "description": "With profile only: call-level flags appended after the profile's own arguments (never before them, never replacing one). Needs the start:args scope. Each element follows the input rules; the profile's argv and extra_args together stay within 256 elements; an agent's refused flags (OpenCode auto-approve, Devin --permission-mode and --respect-workspace-trust) are refused here too. They run with the profile's credentials, so do not put a secret in them. Not the profile file's extra_args key, which the operator fixes. An older server ignores this field: read the argv in the returned pane to see what ran.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "line": {
            "description": "Shell line run by sh -c. Only when arbitrary commands are allowed.",
            "type": "string"
          },
          "name": {
            "description": "Pane name: 1-32 of a-z, 0-9, '-', '_', '.'. Optional; Shepherd picks one when it is missing.",
            "type": "string"
          },
          "profile": {
            "description": "Launch profile name, as list_panes shows it.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "start_pane"
    },
    {
      "inputSchema": {
        "properties": {
          "terminal": {
            "type": "string"
          },
          "timeout": {
            "default": 30.0,
            "maximum": 1800.0,
            "minimum": 1.0,
            "type": "number"
          }
        },
        "required": [
          "terminal"
        ],
        "type": "object"
      },
      "name": "wait_status"
    }
  ]
}
